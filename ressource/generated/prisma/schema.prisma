generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Visibilite {
  PUBLIQUE
  PARTAGEE
  PRIVEE
}

enum StatutPublication {
  BROUILLON
  EN_ATTENTE
  VALIDEE
  SUSPENDUE
}

enum StatutSession {
  EN_COURS
  TERMINEE
}

enum TypeActionStats {
  CONSULTATION
  RECHERCHE
  PARTAGE
  EXPLOITATION
  CREATION
}

enum RoleUser {
  USER
  ADMIN
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  est_actif     Boolean  @default(true)
  date_creation DateTime @default(now())

  role_id            RoleUser                 @default(USER)
  emailVerified      Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @default(now()) @updatedAt
  sessions           Session[]
  accounts           Account[]
  ressources_creees  Ressource[]
  progressions       ProgressionUtilisateur[]
  commentaires       Commentaire[]
  sessions_initiees  SessionActivite[]
  sessions_rejointes ParticipantSession[]
  messages           MessageSession[]
  logs_statistiques  StatistiqueLog[]

  @@index([role_id])
}

model Categorie {
  id         String      @id @default(uuid())
  libelle    String      @unique
  ressources Ressource[]
}

model TypeRelation {
  id         String      @id @default(uuid())
  libelle    String      @unique
  ressources Ressource[]
}

model TypeRessource {
  id         String      @id @default(uuid())
  libelle    String      @unique
  ressources Ressource[]
}

model Ressource {
  id                 String            @id @default(uuid())
  titre              String
  contenu            String            @db.Text
  visibilite         Visibilite        @default(PRIVEE)
  statut_publication StatutPublication @default(BROUILLON)
  date_creation      DateTime          @default(now())
  date_mise_a_jour   DateTime          @updatedAt

  auteur_id String
  auteur    User   @relation(fields: [auteur_id], references: [id])

  categorie_id String
  categorie    Categorie @relation(fields: [categorie_id], references: [id])

  type_relation_id String
  type_relation    TypeRelation @relation(fields: [type_relation_id], references: [id])

  type_ressource_id String
  type_ressource    TypeRessource @relation(fields: [type_ressource_id], references: [id])

  progressions      ProgressionUtilisateur[]
  commentaires      Commentaire[]
  sessions          SessionActivite[]
  logs_statistiques StatistiqueLog[]

  @@index([auteur_id])
  @@index([categorie_id])
}

model ProgressionUtilisateur {
  utilisateur_id       String
  ressource_id         String
  est_favori           Boolean  @default(false)
  est_mise_de_cote     Boolean  @default(false)
  est_exploitee        Boolean  @default(false)
  date_derniere_action DateTime @updatedAt

  user      User      @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  ressource Ressource @relation(fields: [ressource_id], references: [id], onDelete: Cascade)

  @@id([utilisateur_id, ressource_id])
}

model Commentaire {
  id               String   @id @default(uuid())
  contenu          String   @db.Text
  date_publication DateTime @default(now())
  est_modere       Boolean  @default(true)

  auteur_id String
  auteur    User   @relation(fields: [auteur_id], references: [id], onDelete: Cascade)

  ressource_id String
  ressource    Ressource @relation(fields: [ressource_id], references: [id], onDelete: Cascade)

  parent_id String?
  parent    Commentaire?  @relation("ReponsesCommentaire", fields: [parent_id], references: [id], onDelete: Cascade)
  reponses  Commentaire[] @relation("ReponsesCommentaire")

  @@index([auteur_id])
  @@index([ressource_id])
}

model SessionActivite {
  id             String        @id @default(uuid())
  date_demarrage DateTime      @default(now())
  statut         StatutSession @default(EN_COURS)

  ressource_id String
  ressource    Ressource @relation(fields: [ressource_id], references: [id], onDelete: Cascade)

  initiateur_id String
  initiateur    User   @relation(fields: [initiateur_id], references: [id], onDelete: Cascade)

  participants ParticipantSession[]
  messages     MessageSession[]

  @@index([ressource_id])
  @@index([initiateur_id])
}

model ParticipantSession {
  session_id      String
  utilisateur_id  String
  date_invitation DateTime @default(now())
  a_accepte       Boolean  @default(false)

  session SessionActivite @relation(fields: [session_id], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@id([session_id, utilisateur_id])
}

model MessageSession {
  id         String   @id @default(uuid())
  contenu    String   @db.Text
  date_envoi DateTime @default(now())

  session_id String
  session    SessionActivite @relation(fields: [session_id], references: [id], onDelete: Cascade)

  auteur_id String
  auteur    User   @relation(fields: [auteur_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([auteur_id])
}

model StatistiqueLog {
  id                String          @id @default(uuid())
  type_action       TypeActionStats
  date_action       DateTime        @default(now())
  zone_geographique String?

  utilisateur_id String?
  user           User?   @relation(fields: [utilisateur_id], references: [id], onDelete: SetNull)

  ressource_id String?
  ressource    Ressource? @relation(fields: [ressource_id], references: [id], onDelete: SetNull)
}

// --- AUTH TABLES (Optimisées) ---

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
