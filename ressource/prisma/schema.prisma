generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibilite {
  PUBLIQUE
  PARTAGEE
  PRIVEE
}

enum StatutPublication {
  BROUILLON
  EN_ATTENTE
  VALIDEE
  SUSPENDUE
}

enum StatutSession {
  EN_COURS
  TERMINEE
}

enum TypeActionStats {
  CONSULTATION
  RECHERCHE
  PARTAGE
  EXPLOITATION
  CREATION
}

model Role {
  id           String        @id @default(uuid())
  libelle      String        @unique
  utilisateurs Utilisateur[]
}

model Utilisateur {
  id                String   @id @default(uuid())
  email             String   @unique
  mot_de_passe_hash String
  nom               String
  prenom            String
  est_actif         Boolean  @default(true)
  date_creation     DateTime @default(now())

  role_id String
  role    Role   @relation(fields: [role_id], references: [id])

  ressources_creees  Ressource[]
  progressions       ProgressionUtilisateur[]
  commentaires       Commentaire[]
  sessions_initiees  SessionActivite[]
  sessions_rejointes ParticipantSession[]
  messages           MessageSession[]
  logs_statistiques  StatistiqueLog[]
}

model Categorie {
  id         String      @id @default(uuid())
  libelle    String      @unique
  ressources Ressource[]
}

model TypeRelation {
  id         String      @id @default(uuid())
  libelle    String      @unique
  ressources Ressource[]
}

model TypeRessource {
  id         String      @id @default(uuid())
  libelle    String      @unique
  ressources Ressource[]
}

model Ressource {
  id                 String            @id @default(uuid())
  titre              String
  contenu            String            @db.Text
  visibilite         Visibilite        @default(PRIVEE)
  statut_publication StatutPublication @default(BROUILLON)
  date_creation      DateTime          @default(now())
  date_mise_a_jour   DateTime          @updatedAt

  auteur_id String
  auteur    Utilisateur @relation(fields: [auteur_id], references: [id])

  categorie_id String
  categorie    Categorie @relation(fields: [categorie_id], references: [id])

  type_relation_id String
  type_relation    TypeRelation @relation(fields: [type_relation_id], references: [id])

  type_ressource_id String
  type_ressource    TypeRessource @relation(fields: [type_ressource_id], references: [id])

  progressions      ProgressionUtilisateur[]
  commentaires      Commentaire[]
  sessions          SessionActivite[]
  logs_statistiques StatistiqueLog[]
}

model ProgressionUtilisateur {
  utilisateur_id       String
  ressource_id         String
  est_favori           Boolean  @default(false)
  est_mise_de_cote     Boolean  @default(false)
  est_exploitee        Boolean  @default(false)
  date_derniere_action DateTime @updatedAt

  utilisateur Utilisateur @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)
  ressource   Ressource   @relation(fields: [ressource_id], references: [id], onDelete: Cascade)

  @@id([utilisateur_id, ressource_id])
}

model Commentaire {
  id               String   @id @default(uuid())
  contenu          String   @db.Text
  date_publication DateTime @default(now())
  est_modere       Boolean  @default(true)

  auteur_id String
  auteur    Utilisateur @relation(fields: [auteur_id], references: [id], onDelete: Cascade)

  ressource_id String
  ressource    Ressource @relation(fields: [ressource_id], references: [id], onDelete: Cascade)

  parent_id String?
  parent    Commentaire?  @relation("ReponsesCommentaire", fields: [parent_id], references: [id], onDelete: Cascade)
  reponses  Commentaire[] @relation("ReponsesCommentaire")
}

model SessionActivite {
  id             String        @id @default(uuid())
  date_demarrage DateTime      @default(now())
  statut         StatutSession @default(EN_COURS)

  ressource_id String
  ressource    Ressource @relation(fields: [ressource_id], references: [id], onDelete: Cascade)

  initiateur_id String
  initiateur    Utilisateur @relation(fields: [initiateur_id], references: [id], onDelete: Cascade)

  participants ParticipantSession[]
  messages     MessageSession[]
}

model ParticipantSession {
  session_id      String
  utilisateur_id  String
  date_invitation DateTime @default(now())
  a_accepte       Boolean  @default(false)

  session     SessionActivite @relation(fields: [session_id], references: [id], onDelete: Cascade)
  utilisateur Utilisateur     @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade)

  @@id([session_id, utilisateur_id])
}

model MessageSession {
  id         String   @id @default(uuid())
  contenu    String   @db.Text
  date_envoi DateTime @default(now())

  session_id String
  session    SessionActivite @relation(fields: [session_id], references: [id], onDelete: Cascade)

  auteur_id String
  auteur    Utilisateur @relation(fields: [auteur_id], references: [id], onDelete: Cascade)
}

model StatistiqueLog {
  id                String          @id @default(uuid())
  type_action       TypeActionStats
  date_action       DateTime        @default(now())
  zone_geographique String?

  utilisateur_id String?
  utilisateur    Utilisateur? @relation(fields: [utilisateur_id], references: [id], onDelete: SetNull)

  ressource_id String?
  ressource    Ressource? @relation(fields: [ressource_id], references: [id], onDelete: SetNull)
}
